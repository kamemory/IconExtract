<Window x:Class="IconExtract.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IconExtract"
        xmlns:vm="clr-namespace:IconExtract.ViewModels"
        mc:Ignorable="d"
        Title="アイコンを保存したいのよ" Height="240" Width="440"
        AllowDrop="True"
        Loaded="Window_Loaded"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox Margin="8"
                 ItemsSource="{Binding Path=ExtractTargets}"
                 DisplayMemberPath="FilePath">
        </ListBox>

        <Button Grid.Row="1"
                HorizontalAlignment="Right"
                Margin="0,0,8,8"
                Padding="16,8"
                Content="一括抽出"
                Command="{Binding Path=AllExtractCommand}"/>
    </Grid>
</Window>
